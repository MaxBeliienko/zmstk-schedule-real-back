PORT=8080
MONGODB_URI=mongodb+srv://user:password@cluster/db
# Обов'язково, мінімум 16 символів — без нього сервер не стартує
JWT_SECRET=change-me-to-a-long-random-string
# Обов'язково, мінімум 16 символів. Секрет для паролів: НЕ змінюйте і НЕ втрачайте
# (інакше жоден пароль не підійде). Має збігатися всюди, де використовується ця база
PASSWORD_PEPPER=change-me-to-another-long-random-string
# Лише на час заміни PASSWORD_PEPPER: сюди — попереднє значення (див. README)
# PASSWORD_PEPPER_OLD=
# Пароль першого адміністратора (коли в базі ще немає жодного адміна) і для npm run reset-admin
ADMIN_PASSWORD=
# Пароль першого бухгалтера — використовується лише один раз при переході на облікові записи
ACCOUNTANT_PASSWORD=
# Дозволені домени фронтенду через кому (якщо не задано — дозволено всі)
CORS_ORIGIN=https://your-frontend.vercel.app,http://localhost:5173
# Кількість проксі перед сервером (для коректного ліміту спроб входу за IP).
# 0 — сервер доступний напряму; 1 — за одним проксі (Cloud Run, Render, Railway…)
TRUST_PROXY=0
# Необов'язково: шапка "ЗАТВЕРДЖУЮ" у графіку групи (Word). Без них — значення
# з config/documents.js (Директор / Знам’янського МСТК ТСОУ / Володимир КОЛЕБІДЕНКО)
# DOC_APPROVER_POSITION=Директор
# DOC_APPROVER_ORGANIZATION=Знам’янського МСТК ТСОУ
# DOC_APPROVER_NAME=Володимир КОЛЕБІДЕНКО
